meta {
  name: Sign in password
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/api/auth
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
{
  "provider": "PASSWORD",
  "email": "{{email}}",
  "password": "{{password}}"
}
}

script:post-response {
  if (res.body && res.body.accessToken) {
    bru.setEnvVar('token', res.body.accessToken);
  }
  if (res.body && res.body.refreshToken) {
    bru.setEnvVar('refreshToken', res.body.refreshToken);
  }

}

